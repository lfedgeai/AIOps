# Copy to config/.env and add your values. Do not commit config/.env.
#
# Hosted agents: LiteLLM / OpenAI-compatible gateway (required for MaaS agents)
DEEPSEEK_API_BASE=https://your-litellm-gateway.example.com/v1
QWEN3_API_BASE=https://your-litellm-gateway.example.com/v1
QWEN38_API_BASE=https://maas-rhdp.apps.maas.redhatworkshops.io/v1
QWEN36_API_BASE=https://litemaas.rhoai.rh-aiservices-bu.com/v1
KIMI_API_BASE=https://maas.apps.ocp.cloud.rhai-tmm.dev/prelude-maas/kimi-k2-7/v1
NEMOTRON_API_BASE=https://maas.apps.ocp.cloud.rhai-tmm.dev/prelude-maas/nemotron-cascade-2-30b/v1
LLAMA_SCOUT_API_BASE=https://your-litellm-gateway.example.com/v1
GPT_OSS_API_BASE=https://your-litellm-gateway.example.com/v1
GRANITE_API_BASE=https://your-litellm-gateway.example.com/v1
LLAMA31_70B_API_BASE=https://your-litellm-gateway.example.com/v1
GLM_API_BASE=https://your-litellm-gateway.example.com/v1
#
# Model API keys (one per agent — get from your LiteLLM / MaaS admin)
DEEPSEEK_API_KEY=your-deepseek-key
QWEN3_API_KEY=your-qwen3-key
QWEN38_API_KEY=your-qwen38-key
QWEN36_API_KEY=your-qwen36-key
KIMI_API_KEY=your-kimi-key
NEMOTRON_API_KEY=your-nemotron-key
LLAMA_SCOUT_API_KEY=your-llama-scout-key
GPT_OSS_API_KEY=your-gpt-oss-key
GRANITE_API_KEY=your-granite-key
LLAMA31_70B_API_KEY=your-llama31-70b-key
GLM_API_KEY=your-glm-key
#
# Optional model id overrides (must match gateway / key allowlist)
# QWEN3_MODEL=qwen3-14b
# QWEN38_MODEL=qwen38-27b
# QWEN36_MODEL=Qwen3.8-27B
# KIMI_MODEL=kimi-k2-7
# NEMOTRON_MODEL=nemotron-cascade-2-30b
# GPT_OSS_MODEL=gpt-oss-120b
# GRANITE_MODEL=granite-3-2-8b-instruct
# LLAMA31_70B_MODEL=llama-31-70b-cpu
# GLM_MODEL=glm-53-flash
#
# Oracle judge (hybrid RCA/remediation scoring — uses different model than agent)
# JUDGE_MODEL=qwen3-14b
# JUDGE_API_BASE=https://your-litellm-gateway.example.com/v1
# JUDGE_API_KEY=your-judge-key
# HARNESS_DISABLE_JUDGE=1
#
# ClickHouse namespace (observability platform tier; not otel-demo)
# CLICKHOUSE_NAMESPACE=agentic-aiops
KUBEADMIN_PASSWORD=your-kubeadmin-password
#
# MLflow — local only (scripts/ensure_local_mlflow.sh starts :5050 if needed)
MLFLOW_TRACKING_URI=http://localhost:5050
MLFLOW_TRACKING_INSECURE_TLS=false
# Do not use the OpenShift mlflow route/service for harness runs.
