FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py .

ENV EDGELAKE_URL=http://host.containers.internal:32159
ENV EDGELAKE_DB=monitoring
ENV EDGELAKE_TABLE=otel_edge_metrics

EXPOSE 4318

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "4318"]
