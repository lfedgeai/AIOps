# ============================================================================
# Standalone AIOps Evaluation Harness — deployment configuration
# Copy to .env and fill in. .env is gitignored.
#
# The deployment runs on an EXISTING OpenShift 4.x cluster with RHOAI 3.4+
# for the EvalHub/Evaluations UI path. Cluster provisioning on AWS is out of
# scope; the AWS_* block at the bottom captures the inputs for it.
# ============================================================================

# --- Cluster access (use one of: kubeconfig, token, or user/password) -------
KUBECONFIG=${HOME}/.kube/config
OCP_API_URL=https://api.cluster.example.com:6443
OCP_TOKEN=
OCP_USERNAME=
OCP_PASSWORD=
OCP_INSECURE=1

# --- Namespaces -------------------------------------------------------------
# The vendored OTEL demo manifest is rendered into OTEL_DEMO_NAMESPACE.
AIOPS_NAMESPACE=agentic-aiops
OTEL_DEMO_NAMESPACE=otel-demo
HARNESS_NAMESPACE=agentic-aiops
K8S_FAULT_NAMESPACE=otel-demo

# --- Storage ----------------------------------------------------------------
# On AWS OCP the default EBS class is usually gp3-csi. Use `oc get sc` to check.
STORAGE_CLASS=gp3-csi
CLICKHOUSE_STORAGE_SIZE=50Gi
MLFLOW_STORAGE_SIZE=10Gi
HARNESS_STORAGE_SIZE=20Gi

# --- RHOAI / EvalHub (optional) --------------------------------------------
# RHOAI has three relevant namespaces; none are guaranteed to use the defaults.
# 1) operator subscription/CSV namespace (OperatorHub install target)
RHOAI_OPERATOR_NAMESPACE=redhat-ods-operator
# 2) applications namespace: dashboard, MLflow, TrustyAI, platform EvalHub
#    (DSCInitialization.spec.applicationsNamespace)
RHOAI_APPLICATIONS_NAMESPACE=redhat-ods-applications
# Legacy alias used by older scripts; leave empty unless you only set this one.
RHOAI_NAMESPACE=
# 3) tenant/workbench namespace where user EvalHub jobs run
EVALHUB_NAMESPACE=rhods-notebooks
# Platform EvalHub CR for the dashboard health check.
# Leave empty to use RHOAI_APPLICATIONS_NAMESPACE.
EVALHUB_PLATFORM_NAMESPACE=
# EvalHub tenant alias used by some helper scripts; leave empty to use EVALHUB_NAMESPACE.
EVALHUB_TENANT=
RHOAI_CHANNEL=stable-3.4
REQUIRE_RHOAI=0
ENABLE_EVALHUB=0

# The cluster global pull secret must contain credentials for registry.redhat.io
# (and usually registry.connect.redhat.com) for RHOAI operator/catalog images.
PULL_SECRET_NAMESPACE=openshift-config
PULL_SECRET_NAME=pull-secret
CHECK_PULL_SECRET=1

# --- MLflow ----------------------------------------------------------------
# MLFLOW_MODE: cluster | local | external
# cluster  = use MLFLOW_TRACKING_URI (in-cluster DNS or a Route)
# local    = start a SQLite MLflow server on MLFLOW_PORT (laptop/workbench)
MLFLOW_MODE=cluster
MLFLOW_TRACKING_URI=http://mlflow.agentic-aiops.svc.cluster.local:5000
MLFLOW_TRACKING_INSECURE_TLS=false
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:v3.10.1
MLFLOW_PORT=5050

# --- ClickHouse / telemetry -------------------------------------------------
CLICKHOUSE_HTTP=http://clickhouse.agentic-aiops.svc.cluster.local:8123
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.3
CLICKHOUSE_PORT_FORWARD=0
CLICKHOUSE_LOCAL_PORT=38123
LEAN_OTEL_DEMO=0
CLICKHOUSE_COLLECTOR_ENDPOINT=tcp://clickhouse.agentic-aiops.svc.cluster.local:9000?dial_timeout=10s

# --- Harness runtime --------------------------------------------------------
HARNESS_IMAGE=quay.io/your-org/aiops-harness:latest
HARNESS_PYTHON=python3
HARNESS_PREFLIGHT=0
HARNESS_SMOKE_AGENT=rhdp_qwen3-14b
HARNESS_ARGS="--scenario a --flag scale_zero --variant cart --agents rhdp_qwen3-14b"
HARNESS_EXTRA_ARGS=
MATRIX_CELL_GAP=5
SKIP_EXISTING=1
ENABLE_NODE_FAULTS=0
# Leave blank to run all six default agents; comma-separate to restrict.
HARNESS_AGENTS=

# --- Optional raw vLLM fallback --------------------------------------------
VLLM_ENABLED=0
VLLM_IMAGE=vllm/vllm-openai:v0.8.5
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_SERVED_MODEL_NAME=qwen2.5-7b-instruct
VLLM_GPU_COUNT=1
VLLM_GPU_RESOURCE=nvidia.com/gpu
VLLM_MAX_MODEL_LEN=16384
VLLM_TOOL_CALL_PARSER=hermes
VLLM_MODEL_CACHE_SIZE=50Gi
HF_TOKEN=

# If using the vLLM fallback, point one agent at it:
#   QWEN3_API_BASE=https://<vllm-route>/v1
#   QWEN3_API_KEY=dummy
#   QWEN3_MODEL=qwen2.5-7b-instruct

# ============================================================================
# Model endpoints (OpenAI-compatible /v1/chat/completions with tool calling)
# Use MaaS/LiteLLM, RHOAI KServe/vLLM, or the raw vLLM fallback.
# Set only the agents you intend to run. The matrix preflight is strict by
# default; set HARNESS_ALLOW_MISSING_AGENTS=1 to skip unconfigured agents.
# ============================================================================
HARNESS_ALLOW_MISSING_AGENTS=0

# If your model/RHOAI route uses a private CA, set SSL_CERT_FILE=/path/ca.crt

# DeepSeek R1 Distill 14B
DEEPSEEK_API_BASE=https://your-litellm-gateway.example.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-r1-distill-qwen-14b

# Qwen3-14B
QWEN3_API_BASE=https://your-litellm-gateway.example.com/v1
QWEN3_API_KEY=
QWEN3_MODEL=qwen3-14b

# Qwen3.8-27B (RHDP gateway)
QWEN38_API_BASE=https://your-litellm-gateway.example.com/v1
QWEN38_API_KEY=
QWEN38_MODEL=qwen38-27b

# Qwen3.8-27B (LiteMaaS gateway; the code's "qwen36" slot is actually Qwen3.8)
QWEN36_API_BASE=https://your-litellm-gateway.example.com/v1
QWEN36_API_KEY=
QWEN36_MODEL=Qwen3.8-27B

# Granite 3.2 8B Instruct
GRANITE_API_BASE=https://your-litellm-gateway.example.com/v1
GRANITE_API_KEY=
GRANITE_MODEL=granite-3-2-8b-instruct

# GLM-5.3 Flash
GLM_API_BASE=https://your-litellm-gateway.example.com/v1
GLM_API_KEY=
GLM_MODEL=glm-53-flash

# Optional oracle judge (different model from the agent under test)
JUDGE_API_BASE=
JUDGE_API_KEY=
JUDGE_MODEL=

# Key used by the EvalHub provider for the model under test. Prefer a Secret
# in production; this value is rendered into the provider ConfigMap for the demo.
LFEDGE_MODEL_API_KEY=

# ============================================================================
# AWS cluster inputs (informational; used only if we provision the cluster)
# ============================================================================
AWS_REGION=us-east-1
AWS_CLUSTER_NAME=aiops-demo
AWS_BASE_DOMAIN=example.com
AWS_CONTROL_PLANE_INSTANCE_TYPE=m6i.xlarge
AWS_WORKER_INSTANCE_TYPE=m6i.4xlarge
AWS_WORKER_REPLICAS=3
AWS_GPU_INSTANCE_TYPE=g5.2xlarge
AWS_GPU_REPLICAS=1
