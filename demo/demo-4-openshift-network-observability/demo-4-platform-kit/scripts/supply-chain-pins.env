# NetObserv demo kit — validated upstream pins (Aug 2026 lab).
# Source from scripts:  source "$(dirname "$0")/supply-chain-pins.env"
# See docs/SUPPLY-CHAIN-PINS.md before bumping any value.

# TrustyAI FMS orchestrator Helm chart (lemonade-stand-assistant)
LEMONADE_REPO="${LEMONADE_REPO:-https://github.com/rh-ai-quickstart/lemonade-stand-assistant.git}"
LEMONADE_BRANCH="${LEMONADE_BRANCH:-nemo-guardrails}"
LEMONADE_COMMIT="${LEMONADE_COMMIT:-b342f224260a5921fd67ee9a191fe007d7550b4d}"

# OpenShell / OpenClaw lab manifests (external checkout on bastion)
OPENCLAW_LAB_REPO="${OPENCLAW_LAB_REPO:-https://github.com/redhat-et/openshell-on-openshift-lab.git}"
OPENCLAW_LAB_COMMIT="${OPENCLAW_LAB_COMMIT:-4a325ae4667eaf316634e6eff0694b7836db98c5}"
OPENCLAW_LAB_DIR="${OPENCLAW_LAB_DIR:-$HOME/labs/openshell-on-openshift-lab}"

# OpenShell stack (chart + gateway; CLI may differ in-pod — see README)
OPENSHELL_CHART_VERSION="${OPENSHELL_CHART_VERSION:-0.0.82}"
OPENSHELL_CLI_VERSION="${OPENSHELL_CLI_VERSION:-0.0.101}"
AGENT_SANDBOX_RELEASE="${AGENT_SANDBOX_RELEASE:-v0.5.1}"
OPENCLAW_GATEWAY_VERSION="${OPENCLAW_GATEWAY_VERSION:-2026.6.11}"

# Site-owned Quay mirrors (greenfield / disconnected) — see demo-4-greenfield-install/docs/IMAGE-MIRRORS.md
QUAY_ORG="${QUAY_ORG:-your-org}"
OPENCLAW_GATEWAY_IMAGE="${OPENCLAW_GATEWAY_IMAGE:-quay.io/${QUAY_ORG}/openclaw-openshift:openclaw-v2026.6.11}"
OPENCLAW_SANDBOX_IMAGE="${OPENCLAW_SANDBOX_IMAGE:-${OPENCLAW_GATEWAY_IMAGE}}"
NETOBSERV_TODO_IMAGE="${NETOBSERV_TODO_IMAGE:-quay.io/${QUAY_ORG}/todo:v1}"

# Gitea (AAP phase — mirrored from ghcr.io/kwkoo/gitea-openshift)
GITEA_IMAGE="${GITEA_IMAGE:-quay.io/${QUAY_ORG}/gitea-openshift}"
GITEA_TAG="${GITEA_TAG:-gitea-openshift-v1}"
GITEA_UPSTREAM_IMAGE="${GITEA_UPSTREAM_IMAGE:-ghcr.io/kwkoo/gitea-openshift:latest}"

# Kraken chaos (bastion fault injection — pod_egress_shaping)
KRKN_IMAGE="${KRKN_IMAGE:-quay.io/krkn-chaos/krkn:v5.2.7}"
KRKN_HOG_IMAGE="${KRKN_HOG_IMAGE:-quay.io/krkn-chaos/krkn-hog:v0.0.2}"
KRKN_TOOLS_IMAGE="${KRKN_TOOLS_IMAGE:-quay.io/krkn-chaos/krkn:tools}"

# NetObserv CLI (mirror `/latest/` currently redirects to this release)
NETOBSERV_CLI_VERSION="${NETOBSERV_CLI_VERSION:-1.9.0}"
NETOBSERV_OPERATOR_CSV="${NETOBSERV_OPERATOR_CSV:-network-observability-operator.v1.12.2}"
NETOBSERV_CLI_URL="${NETOBSERV_CLI_URL:-https://mirror.openshift.com/pub/cgw/netobserv/${NETOBSERV_CLI_VERSION}/oc-netobserv-amd64}"
