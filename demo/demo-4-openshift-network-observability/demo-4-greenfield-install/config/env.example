# Greenfield site configuration — copy to env.local for non-secret settings (optional).
#
#   cp config/env.example config/env.local
#
# **Secrets and endpoints** belong in site-secrets.local.yaml (not here):
#
#   cp config/site-secrets.example.yaml config/site-secrets.local.yaml
#   ./scripts/greenfield-install.sh config prompt
#
# See config/site-secrets.example.yaml for the full schema.

# Path to platform kit (minimal install assets — see docs/PLATFORM-KIT.md)
export DEMO_KIT_ROOT="${DEMO_KIT_ROOT:-$HOME/AIOps/demo/demo-4-openshift-network-observability/demo-4-platform-kit}"

# Site secrets file (gitignored)
export SITE_SECRETS_FILE="${SITE_SECRETS_FILE:-$PWD/config/site-secrets.local.yaml}"

# How to load secrets: hybrid | file | prompt
export GREENFIELD_CONFIG_MODE="${GREENFIELD_CONFIG_MODE:-hybrid}"

# OpenClaw / lab paths
export OPENCLAW_NS="${OPENCLAW_NS:-openclaw}"
export LAB_CFG="${LAB_CFG:-$HOME/labs/openshell-on-openshift-lab/manifests/openclaw/config.yaml}"

# Slack deliver target (event-AIOps bridge + SPIFFE) — also set site.slack_channel_id in site-secrets
# export SLACK_CHANNEL_ID=C0123456789

# Site-owned Quay org (mirrors) — see docs/IMAGE-MIRRORS.md
export QUAY_ORG="${QUAY_ORG:-your-org}"

# OpenClaw container image — mirror from reference cluster first (see docs/PHASE-2-OPENSHELL.md)
export OPENCLAW_GATEWAY_IMAGE="${OPENCLAW_GATEWAY_IMAGE:-quay.io/${QUAY_ORG}/openclaw-openshift:openclaw-v2026.6.11}"
export OPENCLAW_SANDBOX_IMAGE="${OPENCLAW_SANDBOX_IMAGE:-quay.io/${QUAY_ORG}/openclaw-openshift:openclaw-v2026.6.11}"

# Orchestrator behaviour
export AUTO_CONTINUE="${AUTO_CONTINUE:-0}"
export SKIP_RHCL="${SKIP_RHCL:-0}"
export SKIP_RHCL_INGRESS="${SKIP_RHCL_INGRESS:-0}"
export SKIP_SITE_CONFIG="${SKIP_SITE_CONFIG:-0}"

# Resume partial install
export SKIP_NETOBSERV="${SKIP_NETOBSERV:-0}"
export SKIP_OPENCLAW="${SKIP_OPENCLAW:-0}"

# Bastion sync targets (sync-to-bastion.sh) — copy to env.local and set your bastion host
# export BASTION_HOST="bastion.cluster-name.example.com"
export BASTION_HOST="${BASTION_HOST:-bastion.example.com}"
export BASTION_USER="${BASTION_USER:-lab-user}"
export BASTION_GREENFIELD_PATH="${BASTION_GREENFIELD_PATH:-AIOps/demo/demo-4-openshift-network-observability/demo-4-greenfield-install}"
export BASTION_KIT_PATH="${BASTION_KIT_PATH:-AIOps/demo/demo-4-openshift-network-observability/demo-4-platform-kit}"
