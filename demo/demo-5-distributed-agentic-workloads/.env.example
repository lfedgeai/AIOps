# Demo-5 local lab secrets — copy to .env and fill in (gitignored).
# Prefer activation key over username/password when available.
#
#   cp .env.example .env
#   # edit .env
#   set -a && source .env && set +a
#   ./scripts/provision-site-vms.sh

# --- Red Hat Subscription Manager (MicroShift on site VM) ---
# Option A (preferred): org + activation key
RHSM_ORG=
RHSM_ACTIVATION_KEY=

# Option B: username + password (if no activation key)
# RHSM_USER=
# RHSM_PASSWORD=

# --- Optional overrides ---
# RHEL_GUEST_IMAGE=docker://registry.redhat.io/rhel9/rhel-guest-image:9.6
# SITE_ID=site-a
