# Pinned versions for the Tier 3 testbed. Sourced by the scripts in this folder.
# Each value is confirmed in task 1.2-1.4 and recorded in docs/k8s-testbed-notes.md;
# change them only together with that file.
KIND_VERSION=v0.29.0
NODE_IMAGE=kindest/node:v1.33.1@sha256:050072256b9a903bd914c0b2866828150cb229cea0efe5892e2b644d5dd3b34f
CLUSTER=jev
NAMESPACE=otel-demo
RELEASE=otel-demo
CHART_REPO=https://open-telemetry.github.io/opentelemetry-helm-charts
CHART=open-telemetry/opentelemetry-demo
DEMO_APP_VERSION=3.1.0
# Empty: install.sh resolves the chart release whose appVersion is DEMO_APP_VERSION
# and records it in VERSION. Set it here once task 1.4 has confirmed it.
CHART_VERSION=0.42.4
# kindnet (default) or calico: task 1.3 decides which enforces NetworkPolicy.
CNI=kindnet
CALICO_VERSION=v3.29.3
NEED_GB=8  # lowered from 12 on 2026-10-14; demo trimmed (no Kafka, accounting, fraud-detection, Grafana); measured usage in docs/k8s-testbed-notes.md
